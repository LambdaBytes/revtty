[Unit]
Description=revtty outbound remote terminal agent for %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=%i
UMask=0077
StateDirectory=revtty/%i
StateDirectoryMode=0700
ExecStart=/usr/bin/env REVTTY_CONFIG_DIR=/var/lib/revtty/%i/config REVTTY_STATE_DIR=/var/lib/revtty/%i/state /usr/bin/revtty agent run
KillSignal=SIGINT
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
